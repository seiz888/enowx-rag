{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "enowx-rag memgw adapter --host codex" }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "enowx-rag memgw adapter --host codex" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "enowx-rag memgw adapter --host codex" }
        ]
      }
    ]
  }
}
